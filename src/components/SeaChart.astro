---
// Carta de la ría como fondo fijo. src/scripts/sea.ts mueve la cámara y el Láser según la sección visible.
import chart from '../data/ria-coruna.json';

// El campo de regatas se fondea en el navegador según el viento real (src/scripts/regatta-course.ts).
// Aquí solo van el punto de partida del barco, en la bocana de la ría, y los centros candidatos del campo,
// comprobados contra la costa para cualquier dirección de viento.
const harbour: [number, number] = [488, 270];
const courseCenters: [number, number][] = [
  [440, 130],
  [430, 140],
  [463, 125],
  [400, 110],
];
const [torreX, torreY] = chart.points.torre;
---

<div class="sea" aria-hidden="true">
  <svg
    id="sea"
    data-harbour={JSON.stringify(harbour)}
    data-centers={JSON.stringify(courseCenters)}
    data-bbox={JSON.stringify(chart.bbox)}
    data-size={JSON.stringify([chart.width, chart.height])}
  >
    <g id="sea-camera">
      {chart.iso.map((d, i) => <path class={`iso iso--${i}`} d={d} />)}
      <path class="coast" d={chart.land} />
      <text class="label" x="150" y="470">A CORUÑA</text>
      <text class="label" x="740" y="330">OLEIROS</text>
      <text class="label label--light" x={torreX - 6} y={torreY + 12} text-anchor="end">
        Torre de Hércules · GpD(4)B 20s
      </text>
      <circle class="torre-glow" cx={torreX} cy={torreY} r="8" />
      <circle class="torre" cx={torreX} cy={torreY} r="1.6" />
      <g id="sea-course" class="course">
        <path class="route" id="sea-route" d="" />
        <line class="course__line" id="sea-start-line" />
        <line class="course__line" id="sea-finish-line" />
        <g class="course__marker" id="sea-start-committee"><rect x="-4" y="-2.5" width="8" height="5" rx="1.5" /></g>
        <g class="course__marker" id="sea-start-pin"><circle class="course__pin" r="2.5" /></g>
        <g class="course__marker" id="sea-finish-committee"><rect class="course__finish" x="-4" y="-2.5" width="8" height="5" rx="1.5" /></g>
        <g class="course__marker" id="sea-finish-pin"><circle class="course__pin" r="2.5" /></g>
        <g class="course__marker" id="sea-m1"><circle class="course__mark" r="4" /><text x="7" y="-5">1</text></g>
        <g class="course__marker" id="sea-m1a"><circle class="course__mark" r="3" /><text x="6" y="-4">1a</text></g>
        <g class="course__marker" id="sea-m2"><circle class="course__mark" r="4" /><text x="7" y="-5">2</text></g>
      </g>
      <path class="wake" id="sea-wake" d={`M${harbour[0]},${harbour[1]}`} />
      <g class="boat" id="sea-boat" transform={`translate(${harbour[0]} ${harbour[1]})`}>
        <path d="M0,-10 C3.6,-6 3.9,2 3,10 L-3,10 C-3.9,2 -3.6,-6 0,-10Z" />
        <g id="sea-boom">
          <path d="M0,-4 Q2.6,2 0,8" />
          <line x1="0" y1="-4" x2="0" y2="8" />
        </g>
      </g>
    </g>
  </svg>
</div>

<script>
  import '../scripts/sea';
</script>

<style>
  .sea {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Máscara, no fondo: funde la carta hacia la columna de texto. */
    -webkit-mask-image: linear-gradient(90deg, transparent 18%, #000 52%);
    mask-image: linear-gradient(90deg, transparent 18%, #000 52%);
  }
  .sea svg { display: block; width: 100%; height: 100%; }
  .coast { fill: none; stroke: var(--coast-line); stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .iso { fill: none; stroke: var(--iso-line); stroke-width: 0.9; vector-effect: non-scaling-stroke; }
  .iso--1 { stroke-dasharray: 5 4; }
  .route { fill: none; stroke: var(--magenta); stroke-width: 1.2; stroke-dasharray: 3 5; opacity: 0.45; vector-effect: non-scaling-stroke; }
  .wake {
    fill: none;
    stroke: var(--magenta);
    stroke-width: 1.6;
    stroke-linejoin: round;
    opacity: 0.85;
    vector-effect: non-scaling-stroke;
  }
  .label { font-family: var(--font-mono); font-size: 4.2px; letter-spacing: 0.3em; fill: var(--ink-muted); opacity: 0.8; }
  .label--light { fill: var(--magenta); letter-spacing: 0.04em; font-size: 3.4px; }
  .torre { fill: var(--magenta); }
  .torre-glow { fill: var(--magenta); opacity: 0; animation: torre-flash 20s linear infinite; }
  /* Grupo de 4 destellos cada 20 s: (L0.3 oc3.0) x3, L0.3 oc9.8 */
  @keyframes torre-flash {
    0%, 1.5% { opacity: 0.35; }
    1.6%, 16.4% { opacity: 0; }
    16.5%, 18% { opacity: 0.35; }
    18.1%, 32.9% { opacity: 0; }
    33%, 34.5% { opacity: 0.35; }
    34.6%, 49.4% { opacity: 0; }
    49.5%, 51% { opacity: 0.35; }
    51.1%, 100% { opacity: 0; }
  }
  /* El campo aparece cuando el comité lo ha fondeado con el viento del día. */
  .course { opacity: 0; transition: opacity 1200ms var(--ease-fluid); }
  .course.is-set { opacity: 1; }
  .course__line { stroke: var(--ink); stroke-width: 1px; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; opacity: 0.7; }
  .course__marker rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .course__marker .course__finish { fill: var(--flag-blue); }
  .course__pin { fill: var(--mark); opacity: 0.8; }
  .course__mark { fill: var(--mark); }
  .course__marker text { fill: var(--mark); font-family: var(--font-mono); font-size: 10px; font-weight: 500; }
  .boat path { fill: var(--paper); stroke: var(--ink); stroke-width: 1.2px; vector-effect: non-scaling-stroke; }
  .boat line { stroke: var(--ink); stroke-width: 1.6px; stroke-linecap: round; vector-effect: non-scaling-stroke; }

  @media (max-width: 767px) {
    .sea { -webkit-mask-image: none; mask-image: none; opacity: 0.32; }
  }
  @media (prefers-reduced-motion: reduce) {
    .torre-glow { animation: none; }
  }
</style>
