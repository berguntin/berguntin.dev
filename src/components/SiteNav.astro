---
import SignalFlags from './SignalFlags.astro';
import lighthouseIcon from '@phosphor-icons/core/assets/regular/lighthouse.svg?raw';
import sunIcon from '@phosphor-icons/core/assets/regular/sun.svg?raw';
---

<header class="site-header">
  <nav class="nav" aria-label="Principal">
    <a class="nav__home" href="#inicio" aria-current="page">
      <SignalFlags word="Hugo" size="sm" />
      <span>Hugo Bermúdez</span>
    </a>
    <div class="nav__links">
      <a class="nav__link nav__link--wide" href="#recorrido">Recorrido</a>
      <a class="nav__link nav__link--wide" href="#proyectos">Proyectos</a>
      <a class="nav__link" href="#contacto">Contacto</a>
      <button class="nav__theme" type="button" id="theme-toggle" aria-pressed="false">
        <span class="nav__theme-night"><Fragment set:html={lighthouseIcon} /></span>
        <span class="nav__theme-day"><Fragment set:html={sunIcon} /></span>
        <span class="sr-only">Modo noche</span>
      </button>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('theme-toggle') as HTMLButtonElement;
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && media.matches);
  const sync = () => button.setAttribute('aria-pressed', String(isDark()));

  button.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  media.addEventListener('change', sync);
  sync();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--s-200);
    padding-block: calc(env(safe-area-inset-top, 0px) + var(--s-300)) 0;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-200);
  }
  .nav__home {
    display: inline-flex;
    align-items: center;
    gap: var(--s-100);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links { display: flex; align-items: center; gap: var(--s-50); }
  .nav__link,
  .nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-75) var(--s-100);
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--ink-muted);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 500ms var(--ease-fluid),
      color 500ms var(--ease-fluid);
  }
  .nav__theme { width: 40px; height: 40px; padding: 0; }
  .nav__link:hover,
  .nav__theme:hover { color: var(--ink); background: var(--rule); }
  .nav__link:active,
  .nav__theme:active { transform: scale(0.96); }
  .nav__theme :global(svg) { width: 20px; height: 20px; }
  .nav__theme-night { display: contents; }
  .nav__theme-day { display: none; }
  .nav__theme[aria-pressed='true'] .nav__theme-night { display: none; }
  .nav__theme[aria-pressed='true'] .nav__theme-day { display: contents; }

  @media (max-width: 639px) {
    .nav__link--wide { display: none; }
  }
</style>
