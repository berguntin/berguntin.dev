---
import copyIcon from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import envelopeIcon from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';

const email = 'hugo.b.guntin@gmail.com';
const profiles = [
  { label: 'GitHub', href: 'https://github.com/berguntin' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/berguntin' },
];
---

<section class="contact" id="contacto" aria-labelledby="contact-title" data-waypoint="fin" data-zoom="1.1">
  <div class="contact__inner reveal">
    <p class="contact__kicker">Llegada</p>
    <h2 class="contact__title" id="contact-title">¿Navegamos juntos?</h2>
    <p class="contact__lead">Si tienes un producto que tiene que aguantar con mal tiempo, hablemos.</p>
    <div class="contact__actions">
      <a class="button" href={`mailto:${email}`}>
        <Fragment set:html={envelopeIcon} />
        Escríbeme
      </a>
      <span class="contact__email">
        <span id="contact-email" class="contact__address">{email}</span>
        <button class="contact__copy" type="button" data-copy={email} aria-controls="contact-email">
          <Fragment set:html={copyIcon} />
          <span data-copy-label>Copiar</span>
        </button>
      </span>
    </div>
    <ul class="contact__profiles">
      {
        profiles.map((profile) => (
          <li>
            <a href={profile.href} rel="me noopener" target="_blank">
              {profile.label}
              <span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.querySelector('[data-copy-label]');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (label) label.textContent = 'Copiado';
      } catch {
        const target = document.getElementById(button.getAttribute('aria-controls') ?? '');
        if (target) getSelection()?.selectAllChildren(target);
        if (label) label.textContent = 'Selecciónalo y cópialo';
      }
      setTimeout(() => label && (label.textContent = 'Copiar'), 2400);
    });
  }
</script>

<style>
  .contact {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--s-200);
    padding-block: var(--s-900);
  }
  .contact__inner { display: grid; gap: var(--s-300); max-width: 560px; }
  .contact__kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--magenta);
  }
  .contact__title { font-size: 3rem; line-height: 1; font-weight: 600; letter-spacing: -0.03em; }
  .contact__lead { font-size: 1.25rem; line-height: 1.75rem; color: var(--ink-muted); }
  .contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-200); }
  .contact__email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-75);
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .contact__address { user-select: all; overflow-wrap: anywhere; }
  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--s-50);
    padding: var(--s-50) var(--s-75);
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--sea);
    color: var(--ink-muted);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1rem;
    cursor: pointer;
    transition: background-color 500ms var(--ease-fluid), color 500ms var(--ease-fluid);
  }
  .contact__copy:hover { color: var(--ink); background: var(--rule); }
  .contact__copy:active { transform: scale(0.98); }
  .contact__copy :global(svg) { width: 16px; height: 16px; }
  .contact__profiles { display: flex; gap: var(--s-300); margin: 0; padding: 0; list-style: none; }
  .contact__profiles a { font-weight: 600; text-underline-offset: 3px; }
  .contact__profiles a:hover { color: var(--magenta); }

  @media (max-width: 639px) {
    .contact__title { font-size: 2.25rem; line-height: 2.5rem; }
  }
</style>
