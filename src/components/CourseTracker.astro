---
// Seguimiento de la regata: un campo esquemático con el viento entrando por arriba.
// El Láser avanza hasta la parada que se está leyendo (src/scripts/course.ts).
interface Stop {
  id: string;
  badge: string;
  label: string;
  title: string;
}
interface Props {
  stops: Stop[];
}
const { stops } = Astro.props;

type Point = [number, number];
// Derrota: salida, bordo corto, virada, ceñida a la baliza 1, través a la 2, popa a la 3 y meta.
const track: Point[] = [
  [120, 372],
  [72, 324],
  [200, 196],
  [122, 118],
  [42, 150],
  [42, 296],
  [92, 344],
];
// Índice del punto de la derrota que corresponde a cada parada, y dónde se dibuja su distintivo.
const stopPoints = [0, 2, 3, 4, 5, 6];
const badgeOffset: Point[] = [
  [0, 17],
  [17, 0],
  [0, -17],
  [-17, 0],
  [-17, 0],
  [17, 6],
];
const cumulative = track.map((_, i) =>
  track.slice(0, i).reduce((sum, p, j) => sum + Math.hypot(track[j + 1][0] - p[0], track[j + 1][1] - p[1]), 0),
);
const marks = stops.map((stop, i) => {
  const [px, py] = track[stopPoints[i]];
  return { ...stop, x: px + badgeOffset[i][0], y: py + badgeOffset[i][1], distance: cumulative[stopPoints[i]] };
});
const path = 'M' + track.map(([px, py]) => `${px},${py}`).join('L');
---

<nav class="tracker" aria-label="Recorrido de la regata">
  <div class="tracker__chart">
    <svg viewBox="0 0 240 400" aria-hidden="true" data-track={JSON.stringify(track)}>
      <g class="tracker__wind" transform="translate(206 18)">
        <text x="0" y="0" text-anchor="middle">VIENTO</text>
        <path d="M0,8 V36 M-5,30 L0,37 L5,30" />
      </g>
      <path d={path} class="tracker__track" />
      <path d={path} class="tracker__wake" id="tracker-wake" pathLength="1" />
      <line x1="84" y1="372" x2="160" y2="372" class="tracker__line" />
      <rect x="156" y="366" width="8" height="12" rx="2" class="tracker__committee" />
      <line x1="72" y1="344" x2="112" y2="344" class="tracker__line" />
      <rect x="108" y="338" width="8" height="12" rx="2" class="tracker__committee tracker__committee--finish" />
      {
        marks.map((mark) => (
          <g class="tracker__badge" data-stop-badge={mark.id} data-distance={mark.distance}>
            <circle cx={mark.x} cy={mark.y} r="9" />
            <text x={mark.x} y={mark.y + 3.5} text-anchor="middle">
              {mark.badge}
            </text>
          </g>
        ))
      }
      <g id="tracker-boat" class="tracker__boat" transform={`translate(${track[0][0]} ${track[0][1]})`}>
        <path d="M0,-10 C3.6,-6 3.9,2 3,10 L-3,10 C-3.9,2 -3.6,-6 0,-10Z" class="tracker__hull" />
        <g id="tracker-boom">
          <path d="M0,-4 Q2.6,2 0,8" class="tracker__sail" />
          <line x1="0" y1="-4" x2="0" y2="8" class="tracker__boom" />
        </g>
      </g>
    </svg>
  </div>
  <ol class="tracker__list">
    {
      marks.map((mark) => (
        <li>
          <a href={`#${mark.id}`} data-stop-link={mark.id}>
            <span class="tracker__dot" aria-hidden="true">
              {mark.badge}
            </span>
            <span class="tracker__text">
              <span class="tracker__label">{mark.label}</span>
              <span class="tracker__title">{mark.title}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .tracker {
    display: grid;
    gap: var(--s-300);
  }
  .tracker__chart {
    padding: var(--s-100);
    border: 1px solid var(--ink);
    background: var(--sea);
  }
  .tracker__chart svg { display: block; width: 100%; height: auto; font-family: var(--font-mono); }
  .tracker__wind text { fill: var(--ink-muted); font-size: 9px; letter-spacing: 0.16em; }
  .tracker__wind path { fill: none; stroke: var(--ink-muted); stroke-width: 1.2; stroke-linecap: round; }
  .tracker__track {
    fill: none;
    stroke: var(--magenta);
    stroke-width: 1.2;
    stroke-dasharray: 4 4;
    opacity: 0.45;
  }
  .tracker__wake {
    fill: none;
    stroke: var(--magenta);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--wake, 1);
  }
  .tracker__line { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 2 3; }
  .tracker__committee { fill: var(--paper); stroke: var(--ink); }
  .tracker__committee--finish { fill: var(--flag-blue); }
  .tracker__badge circle {
    fill: var(--paper);
    stroke: var(--mark);
    stroke-width: 1.5;
    transition: fill 600ms var(--ease-fluid);
  }
  .tracker__badge text {
    fill: var(--ink);
    font-size: 10px;
    font-weight: 600;
    transition: fill 600ms var(--ease-fluid);
  }
  .tracker__badge.is-rounded circle { fill: var(--mark); }
  .tracker__badge.is-rounded text { fill: var(--paper); }
  .tracker__hull { fill: var(--paper); stroke: var(--ink); stroke-width: 1; }
  .tracker__sail { fill: var(--paper); stroke: var(--ink); stroke-width: 0.8; }
  .tracker__boom { stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; }

  .tracker__list {
    display: grid;
    gap: var(--s-25);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tracker__list a {
    display: flex;
    align-items: center;
    gap: var(--s-100);
    padding: var(--s-75);
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink-muted);
    transition:
      background-color 500ms var(--ease-fluid),
      color 500ms var(--ease-fluid);
  }
  .tracker__list a:hover { background: var(--rule); color: var(--ink); }
  .tracker__list a:active { transform: translateY(1px); }
  .tracker__list a[aria-current='step'] { color: var(--ink); background: var(--rule); }
  .tracker__dot {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border: 1.5px solid var(--mark);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .tracker__list a[aria-current='step'] .tracker__dot { background: var(--mark); color: var(--paper); }
  .tracker__text { display: grid; min-width: 0; }
  .tracker__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.04em;
  }
  .tracker__title {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
